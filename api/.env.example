# Скопируйте в api/.env и заполните. Файл .env НЕ должен попадать в git.
#
# Где взять значения: console.green-api.com → ваш инстанс.
# idInstance и apiTokenInstance лежат на карточке инстанса.

# Хост API. У новых инстансов Green API он персональный —
# смотрите поле «apiUrl» в консоли, например https://7103.api.greenapi.com
GREEN_API_HOST=https://api.green-api.com

# idInstance из консоли Green API
GREEN_API_ID=

# apiTokenInstance из консоли Green API. Секрет: наружу не отдаётся.
GREEN_API_TOKEN=

# Кому приходят заявки. Только цифры, с кодом страны, без + и пробелов.
OWNER_PHONE=77077238960

# 1 — отправлять гостю подтверждение в WhatsApp, если он оставил номер.
# Расходует сообщения инстанса; на бесплатном тарифе лучше 0.
SEND_CONFIRMATION=0

# Ограничение частоты: сколько сообщений с одного IP за окно
RATE_LIMIT=3
RATE_WINDOW_SECONDS=600

# Origin для локальной разработки, когда фронт на Vite, а PHP на другом порту.
# В продакшене оставьте пустым — тогда работает только тот же домен.
ALLOWED_ORIGIN=

# Путь к файлу лога. Пусто — не логировать.
# Файл должен лежать ВНЕ публичной директории.
LOG_FILE=
