# Скопируйте в api/.env и заполните. Файл .env НЕ должен попадать в git.
#
# Где взять значения:
#   1. В Telegram напишите @BotFather → /newbot → задайте имя и username.
#      Он вернёт токен вида 123456789:AAH...
#   2. Напишите своему боту любое сообщение — иначе он не сможет ответить вам
#      первым, это ограничение Telegram.
#   3. Узнайте свой chat_id: напишите @userinfobot, он пришлёт число.

# Токен от @BotFather. Секрет: наружу не отдаётся.
TELEGRAM_BOT_TOKEN=

# Куда приходят заявки — ваш chat_id (число, может быть отрицательным для групп)
TELEGRAM_CHAT_ID=

# Ограничение частоты: сколько сообщений с одного IP за окно
RATE_LIMIT=3
RATE_WINDOW_SECONDS=600

# Origin для локальной разработки, когда фронт на Vite, а PHP на другом порту.
# В продакшене оставьте пустым — тогда работает только тот же домен.
ALLOWED_ORIGIN=

# Путь к файлу лога. Пусто — не логировать.
# Файл должен лежать ВНЕ публичной директории.
LOG_FILE=
